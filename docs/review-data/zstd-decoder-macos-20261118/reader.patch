     #[test]
+    fn reads_match_individual_source_bits_through_end_of_stream() {
+        for len in 1..=24 {
+            for marker in 0..8 {
+                let mut src: Vec<u8> = (0..len).map(|i| (71 + 97 * i) as u8).collect();
+                src[len - 1] = (src[len - 1] & ((1 << marker) - 1)) | (1 << marker);
+                let end = (len - 1) * 8 + marker;
+                for width in [1, 3, 8, 11, 24, 32, 57] {
+                    let mut r = RevReader::new(&src).unwrap();
+                    let mut used = 0;
+                    while used <= end {
+                        r.refill();
+                        assert_eq!(r.finished(), used == end);
+                        assert_eq!(r.read(0), 0);
+                        let mut expected = 0u64;
+                        for i in used..used + width {
+                            expected <<= 1;
+                            if i < end {
+                                let pos = end - 1 - i;
+                                expected |= u64::from((src[pos / 8] >> (pos % 8)) & 1);
+                            }
+                        }
+                        assert_eq!(r.peek(width as u32), expected);
+                        assert_eq!(r.read(width as u32), expected);
+                        used += width;
+                    }
+                    assert_eq!(r.refill(), Refill::Overflow);
+                    assert_eq!(r.read(7), 0);
+                }
+            }
+        }
+    }
