+/* A sticky directory protects an owned child's name even when other users can
+ * create their own entries. Validate ancestors before using the canonical path. */
+static bool trusted_directory(const char *requested, char resolved[PATH_MAX]) {
+    if (!realpath(requested, resolved)) return false;
+    for (char *next = resolved + 1; ; ++next) {
+        if (*next != '/' && *next != '\0') continue;
+        const bool last = *next == '\0';
+        *next = '\0';
+        struct stat st;
+        if (lstat(resolved, &st) != 0 || !S_ISDIR(st.st_mode) ||
+            (st.st_uid != 0 && st.st_uid != geteuid()) ||
+            ((st.st_mode & (S_IWGRP | S_IWOTH)) && !(st.st_mode & S_ISVTX))) return false;
+        if (last) return true;
+        *next = '/';
+    }
+}
+
+static void temp_directory(char resolved[PATH_MAX]) {
+    const char *base = getenv("TMPDIR");
+    if (!base || !*base) base = P_tmpdir;
+    if (*base != '/' || !trusted_directory(base, resolved))
+        die("Choose a private TMPDIR or the system sticky /tmp directory.");
+}
+
+/* Optional AppImage sidecars redirect profile state, so their names and
+ * terminal directories must be under the launching user's control. */
+static bool use_portable_directory(char *path) {
+    struct stat st;
+    if (lstat(path, &st) != 0) {
+        if (errno == ENOENT) return false;
+        die("Cannot inspect the portable directory.");
+    }
+    char resolved[PATH_MAX];
+    if (!S_ISDIR(st.st_mode) || st.st_uid != geteuid() ||
+        (st.st_mode & (S_IWGRP | S_IWOTH)) || !trusted_directory(path, resolved) ||
+        strcmp(path, resolved) != 0 || access(path, W_OK | X_OK) != 0)
+        die("Use an owned, writable portable directory without links or shared write access.");
+    return true;
 }
 
