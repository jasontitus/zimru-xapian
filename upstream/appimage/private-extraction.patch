+/* The Ubuntu tool is needed only for explicit extraction and no-FUSE launches.
+ * Retain an open image descriptor so the helper reads the selected image. */
+static bool extract_appimage(const char *image, const char *dest, const char *pattern, struct launch_signals *signals) {
+    int fd = open(image, O_RDONLY);
+    if (fd < 0) { perror("open AppImage"); return false; }
+    char input[64], offset[32];
+    snprintf(input, sizeof(input), "/proc/self/fd/%d", fd);
+    snprintf(offset, sizeof(offset), "%zu", (size_t)fs_offset);
+    pid_t pid = fork();
+    if (pid == 0) {
+        restore_child_mask(signals);
+        execl("/usr/bin/unsquashfs", "unsquashfs", "-quiet", "-no-progress",
+              "-strict-errors", "-no-xattrs", "-offset", offset, "-d", dest, input,
+              pattern, (char *)NULL);
+        fprintf(stderr, "Install Ubuntu's squashfs-tools for extraction, or launch Kiwix with FUSE.\n");
+        _exit(EXIT_EXECERROR);
+    }
+    close(fd);
+    if (pid < 0) { perror("start unsquashfs"); return false; }
+    return wait_for_launch(pid, signals) == 0;
 }
 
