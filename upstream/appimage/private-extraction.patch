+static int wait_for_child(pid_t pid) {
+    int status;
+    pid_t waited;
+    do { waited = waitpid(pid, &status, 0); } while (waited < 0 && errno == EINTR);
+    return waited == pid && WIFEXITED(status) ? WEXITSTATUS(status) : EXIT_EXECERROR;
+}
+
+/* No-FUSE launches have a supervisor while FUSE replaces the invoking process.
+ * Block cancellation before creating temporary state or forking, then forward
+ * it only to the exact, still-unreaped child. A child restores the caller's
+ * original mask before exec. */
+struct launch_signals {
+    sigset_t watch, previous;
+    struct sigaction previous_child;
+    int cancelled;
+};
+
+static void begin_supervision(struct launch_signals *signals) {
+    if (sigprocmask(SIG_BLOCK, NULL, &signals->previous) != 0)
+        die("Cannot inspect the AppImage launch signal mask.");
+    sigemptyset(&signals->watch);
+    sigaddset(&signals->watch, SIGCHLD);
+    const int cancellation[] = {SIGTERM, SIGINT, SIGHUP};
+    for (size_t i = 0; i < sizeof(cancellation) / sizeof(cancellation[0]); ++i) {
+        int event = cancellation[i];
+        struct sigaction action;
+        if (sigaction(event, NULL, &action) != 0) die("Cannot inspect launch signal handling.");
+        if (!sigismember(&signals->previous, event) && action.sa_handler != SIG_IGN)
+            sigaddset(&signals->watch, event);
+    }
+    signals->cancelled = 0;
+    struct sigaction own_children = {0};
+    own_children.sa_handler = SIG_DFL;
+    sigemptyset(&own_children.sa_mask);
+    if (sigprocmask(SIG_BLOCK, &signals->watch, &signals->previous) != 0 ||
+        sigaction(SIGCHLD, &own_children, &signals->previous_child) != 0)
+        die("Cannot prepare AppImage launch supervision.");
+}
+
+static void restore_child_mask(const struct launch_signals *signals) {
+    if (sigaction(SIGCHLD, &signals->previous_child, NULL) != 0 ||
+        sigprocmask(SIG_SETMASK, &signals->previous, NULL) != 0) _exit(EXIT_EXECERROR);
